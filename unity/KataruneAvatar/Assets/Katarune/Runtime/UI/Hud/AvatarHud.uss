.hud-root, .hud-bounds { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-root.is-hidden .hud-dock, .hud-root.is-hidden .control-panel { display: none; }
.hud-dock { position: absolute; right: 28px; bottom: 24px; width: 208px; height: 48px; padding: 6px 10px; border-width: 0; border-radius: 24px; background-color: var(--paper); }
.dock-shadow { position: absolute; left: -10px; top: -8px; right: -10px; bottom: -12px; }
.hud-dock.is-dragging { opacity: 0.9; }
.dock-controls, .quick-bar { flex-direction: row; align-items: center; justify-content: space-between; }
.dock-controls { height: 36px; }
.quick-bar { flex-grow: 1; margin-left: 8px; }
.dock-divider { width: 2px; height: 12px; flex-shrink: 0; margin: 0 3px; border-radius: 1px; background-color: #a3a3a3; }
.dock-controls > .quick-bar { border-left-width: 0; }
.compact-mic { display: none; }
.hud-dock.is-compact { width: 88px; height: 44px; padding: 4px 7px; }
.hud-dock.is-compact .quick-bar { display: none; }
.hud-dock.is-compact .compact-mic { display: flex; }
.voice-feedback { display: none; }
.control-panel { display: none; position: absolute; width: 360px; border-width: 0; border-radius: 12px; background-color: var(--paper); overflow: visible; }
.control-panel.is-visible { display: flex; }
.panel-heading { flex-direction: row; align-items: center; justify-content: space-between; padding: 20px 20px 16px 24px; flex-shrink: 0; }
.panel-title { font-size: 18px; -unity-font-style: bold; margin: 0; flex-grow: 1; }
.close-button { width: 28px; height: 28px; }
.close-button .hud-icon { width: 16px; height: 16px; }
.tab-bar { flex-direction: row; margin: 0 20px 8px 20px; height: 32px; flex-shrink: 0; }
.panel-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin: 8px 16px 20px 24px; }
.panel-scroll .unity-scroll-view__content-container { padding-right: 8px; }
.tab-page { display: none; padding: 6px 0 0 0; }
.tab-page.is-visible { display: flex; }
#moreMenu, #shortcutsMenu { padding-top: 0; }
.scale-setting { padding: 14px 0 16px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.scale-setting .help-text { margin: 4px 0 0 0; }
.choice-grid { flex-direction: row; flex-wrap: wrap; }
.choice-button { width: 47%; margin-right: 3%; }
.button-row { flex-direction: row; }
.button-row > .action-button { flex-grow: 1; flex-basis: 0; margin-right: 6px; }
.shortcut-row { flex-direction: row; align-items: center; justify-content: space-between; min-height: 45px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.shortcut-description { font-size: 14px; margin: 0 8px 0 0; flex-grow: 1; }
.shortcut-note { margin: 10px 0 16px 0; }
.mouse-section { padding-top: 14px; border-top-width: 1px; border-top-color: var(--line); margin-bottom: 8px; }
.subtitle-root { display: none; position: absolute; left: 16px; right: 16px; bottom: 24px; align-items: center; }
.subtitle-text { max-width: 640px; margin: 0; padding: 10px 18px; background-color: rgba(23,23,23,0.94); border-radius: 11px; color: white; font-size: 18px; white-space: normal; -unity-text-align: middle-center; }
.subtitle-text.user-subtitle { background-color: var(--paper); color: var(--ink); border-width: 1px; border-color: var(--edge); }