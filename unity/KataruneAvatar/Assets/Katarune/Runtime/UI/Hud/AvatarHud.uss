:root {
    --ink: #151515;
    --paper: #ffffff;
    --line: #151515;
    --disabled: #b7b7b7;
}

.subtitle-root {
    display: none;
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 72px;
    align-items: center;
    -unity-font-definition: url("project://database/Assets/Katarune/Runtime/UI/Hud/Fonts/NotoSansSC-Regular.ttf");
}

.subtitle-text {
    max-width: 880px;
    padding: 16px 24px;
    background-color: rgba(249, 223, 234, 0.9);
    color: #493747;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.65);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-left;
}

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--ink);
    -unity-font-definition: url("project://database/Assets/Katarune/Runtime/UI/Hud/Fonts/NotoSansSC-Regular.ttf");
}

.hud-root.is-hidden {
    display: none;
}

.status-hud {
    position: absolute;
    left: 28px;
    top: 28px;
    width: 430px;
    min-height: 138px;
    padding-left: 18px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    flex-direction: row;
    align-items: center;
    background-color: #e9ecef;
    color: var(--ink);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 0;
}

.status-hud.is-status-hidden {
    display: none;
}

.portrait-frame {
    width: 102px;
    height: 102px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: var(--ink);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.status-content {
    height: 102px;
    min-width: 0;
    margin-left: 20px;
    flex-grow: 1;
    justify-content: center;
}

.model-name {
    max-width: 270px;
    color: var(--ink);
    font-size: 28px;
    -unity-font-style: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.behavior-capsule {
    width: 188px;
    height: 42px;
    margin-top: 12px;
    padding-left: 17px;
    padding-right: 18px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--ink);
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-left-radius: 21px;
    border-bottom-right-radius: 21px;
}

.status-affect-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

.action-label {
    margin-left: 10px;
    color: #ffffff;
    font-size: 16px;
    white-space: nowrap;
}

.notice-label {
    display: none;
    margin-top: 8px;
    color: rgba(21, 21, 21, 0.68);
    font-size: 12px;
    white-space: normal;
}

.notice-label.is-visible {
    display: flex;
}

.radial-stage {
    position: absolute;
    left: 331px;
    bottom: 53px;
    width: 74px;
    height: 74px;
}

.radial-stage.is-dragging {
    opacity: 0.92;
}

.menu-group {
    position: absolute;
    left: 0;
    top: 0;
    width: 74px;
    height: 74px;
    overflow: visible;
    visibility: hidden;
}

.menu-group.is-visible {
    visibility: visible;
}

.radial-button {
    position: absolute;
    justify-content: center;
    align-items: center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: var(--paper);
    color: var(--ink);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--line);
    border-right-color: var(--line);
    border-top-color: var(--line);
    border-bottom-color: var(--line);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    opacity: 0;
    scale: 0.68 0.68;
    translate: 0 24px;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-back;
}

.menu-group.is-visible > .radial-button {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.radial-button:hover {
    background-color: #ffffff;
    scale: 1.08 1.08;
}

.radial-button:active {
    scale: 0.94 0.94;
}

.radial-button.is-selected {
    background-color: var(--ink);
    color: #ffffff;
}

.radial-button:disabled {
    opacity: 1;
    background-color: #e9ecef;
    color: var(--disabled);
    border-left-color: var(--disabled);
    border-right-color: var(--disabled);
    border-top-color: var(--disabled);
    border-bottom-color: var(--disabled);
}

.radial-icon {
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink);
}

.radial-button.is-selected > .radial-icon {
    -unity-background-image-tint-color: #ffffff;
}

.radial-button:disabled > .radial-icon {
    -unity-background-image-tint-color: var(--disabled);
}

.primary-button {
    left: 11px;
    top: 11px;
    width: 52px;
    height: 52px;
}

.primary-button > .radial-icon {
    width: 26px;
    height: 26px;
}

.primary-model {
    transition-delay: 0s;
}

.primary-affect {
    transition-delay: 0.025s;
}

.primary-action {
    transition-delay: 0.05s;
}

.primary-gaze {
    transition-delay: 0.075s;
}

.primary-showcase {
    transition-delay: 0.1s;
}

.primary-more {
    transition-delay: 0.125s;
}

.secondary-button {
    left: 14px;
    top: 14px;
    width: 46px;
    height: 46px;
}

.secondary-button > .radial-icon {
    width: 21px;
    height: 21px;
}

.secondary-slot-0 {
    transition-delay: 0s;
}

.secondary-slot-1 {
    transition-delay: 0.02s;
}

.secondary-slot-2 {
    transition-delay: 0.04s;
}

.secondary-slot-3 {
    transition-delay: 0.06s;
}

.secondary-slot-4 {
    transition-delay: 0.08s;
}

.secondary-slot-5 {
    transition-delay: 0.1s;
}

.central-menu-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 74px;
    height: 74px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: #111111;
    color: #ffffff;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.central-menu-button:hover {
    background-color: #2b2b2b;
    scale: 1.08 1.08;
}

.central-menu-button.is-pointer-active {
    scale: 0.92 0.92;
}

.central-star-art {
    position: absolute;
    left: 19px;
    top: 19px;
    width: 36px;
    height: 36px;
}

.hud-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    opacity: 0;
    scale: 0.95 0.95;
    translate: 0 4px;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.hud-tooltip.is-visible {
    visibility: visible;
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.hud-tooltip__label {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--ink);
    color: #ffffff;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 12px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.icon-model {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/model.svg");
}

.icon-affect {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/affect.svg");
}

.icon-action {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/action.svg");
}

.icon-more {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/more.svg");
}

.icon-eye {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/eye.svg");
}

.icon-showcase-turntable {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/showcase-turntable.svg");
}

.primary-more > .radial-icon {
    width: 28px;
    height: 28px;
}

.icon-neutral {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/neutral.svg");
}

.icon-happy {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/happy.svg");
}

.icon-relaxed {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/relaxed.svg");
}

.icon-sad {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/sad.svg");
}

.icon-angry {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/angry.svg");
}

.icon-surprised {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/surprised.svg");
}

.secondary-button > .icon-neutral,
.secondary-button > .icon-happy,
.secondary-button > .icon-relaxed,
.secondary-button > .icon-sad,
.secondary-button > .icon-angry,
.secondary-button > .icon-surprised {
    width: 25px;
    height: 25px;
}

.icon-folder-open {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/folder-open.svg");
}

.icon-refresh {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/refresh-cw.svg");
}

.icon-trash {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/trash-2.svg");
}

.icon-hand {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/hand.svg");
}

.icon-explain {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/message-circle-more.svg");
}

.icon-party {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/party-popper.svg");
}

.secondary-button > .icon-party {
    width: 25px;
    height: 25px;
}

.icon-wind {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/wind.svg");
}

.secondary-button > .icon-wind {
    width: 27px;
    height: 20px;
}

.icon-stop {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/circle-stop.svg");
}

.icon-sun {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/sun.svg");
}

.icon-moon {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/moon.svg");
}

.secondary-button > .icon-moon {
    width: 21px;
    height: 21px;
}

.icon-outline {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/circle-dashed.svg");
}

.icon-status-hud {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/panel-top.svg");
}

.icon-reset {
    background-image: url("project://database/Assets/Katarune/Runtime/UI/Hud/Icons/rotate-ccw.svg");
}
