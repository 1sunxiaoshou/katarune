/* Match Electron button/switch (150 ms), popover (100 ms), settings (220/280 ms).
   USS uses its built-in ease-out-cubic for the web settings cubic-bezier curve. */
.dock-handle .hud-icon { rotate: 0deg; transition: rotate 220ms ease-out-cubic; }
.hud-dock.is-compact .dock-handle .hud-icon { rotate: 180deg; }
.hud-dock { transition: width 220ms ease-out-cubic, opacity 150ms ease-in-out; }
.quick-button, .compact-mic, .dock-handle, .close-button { scale: 1 1; transition: background-color 150ms ease-in-out, scale 150ms ease-in-out; }
.quick-button:active, .compact-mic:active, .dock-handle.is-pointer-active, .close-button:active { scale: 0.9 0.9; }
.action-button, .choice-button, .text-action { translate: 0 0; transition: background-color 150ms ease-in-out, translate 150ms ease-in-out; }
.action-button:active, .choice-button:active, .text-action:active { translate: 0 1px; }
.tab-button { transition: color 150ms ease-in-out; }
.tab-indicator { transition: translate 280ms ease-out-cubic, width 280ms ease-out-cubic; }
.control-panel { opacity: 1; scale: 1 1; translate: 0 0; transition: opacity 100ms ease-out, scale 100ms ease-out, translate 100ms ease-out; }
.control-panel.is-entering { opacity: 0; scale: 0.95 0.95; translate: 0 8px; }
.control-panel.opens-below.is-entering { translate: 0 -8px; }
.tab-page { opacity: 1; translate: 0 0; transition: opacity 220ms ease-out-cubic, translate 220ms ease-out-cubic; }
.tab-page.is-entering { opacity: 0; translate: 0 6px; }
.setting-toggle > .unity-base-field__input { transition: background-color 150ms ease-in-out; }
.setting-toggle .unity-toggle__checkmark { transition: translate 150ms ease-in-out; }
.hud-tooltip { opacity: 0; scale: 0.95 0.95; transition: opacity 100ms ease-out, scale 100ms ease-out; }
.hud-tooltip.is-visible { opacity: 1; scale: 1 1; }
.mic-indicator { transition: opacity 150ms ease-in-out; }
