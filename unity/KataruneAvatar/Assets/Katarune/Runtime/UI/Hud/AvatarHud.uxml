<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hud="Katarune.Avatar">
    <ui:Style src="AvatarHud.uss" />
    <ui:VisualElement name="hudRoot" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="statusHud" class="status-hud is-status-hidden" picking-mode="Ignore">
            <ui:VisualElement name="portraitFrame" class="portrait-frame" picking-mode="Ignore" />
            <ui:VisualElement class="status-content" picking-mode="Ignore">
                <ui:Label name="modelNameLabel" text="未加载角色" class="model-name" picking-mode="Ignore" />
                <ui:VisualElement name="behaviorCapsule" class="behavior-capsule" picking-mode="Ignore">
                    <ui:VisualElement name="affectStatusIcon" class="status-affect-icon icon-neutral" picking-mode="Ignore" />
                    <ui:Label name="actionLabel" text="无动作" class="action-label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="noticeLabel" text="" class="notice-label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <hud:AvatarRadialMenu name="radialStage" class="radial-stage" primary-radius="112" secondary-radius="184" side-sweep-angle="180" corner-sweep-angle="90" edge-padding="16">
            <ui:VisualElement name="primaryMenu" class="menu-group primary-menu" picking-mode="Ignore">
                <hud:AvatarHudIconButton name="modelCategoryButton" tooltip="模型" icon-class="icon-model" class="radial-button primary-button primary-model" />
                <hud:AvatarHudIconButton name="affectCategoryButton" tooltip="表情" icon-class="icon-affect" class="radial-button primary-button primary-affect" />
                <hud:AvatarHudIconButton name="actionCategoryButton" tooltip="动作" icon-class="icon-action" class="radial-button primary-button primary-action" />
                <hud:AvatarHudIconButton name="gazeTrackingButton" tooltip="视线跟随" icon-class="icon-eye" class="radial-button primary-button primary-gaze" />
                <hud:AvatarHudIconButton name="showcaseControlButton" tooltip="角色展示：左拖旋转角色，滚轮平滑缩放" icon-class="icon-showcase-turntable" class="radial-button primary-button primary-showcase" />
                <hud:AvatarHudIconButton name="moreCategoryButton" tooltip="更多" icon-class="icon-more" class="radial-button primary-button primary-more" />
            </ui:VisualElement>

            <ui:VisualElement name="modelMenu" class="menu-group secondary-menu" picking-mode="Ignore">
                <hud:AvatarHudIconButton name="selectModelButton" tooltip="选择 VRM 模型" icon-class="icon-folder-open" class="radial-button secondary-button secondary-slot-1" />
                <hud:AvatarHudIconButton name="reloadModelButton" tooltip="重新加载当前模型" icon-class="icon-refresh" class="radial-button secondary-button secondary-slot-2" />
                <hud:AvatarHudIconButton name="unloadModelButton" tooltip="卸载当前模型" icon-class="icon-trash" class="radial-button secondary-button secondary-slot-3 destructive-button" />
            </ui:VisualElement>

            <ui:VisualElement name="affectMenu" class="menu-group secondary-menu" picking-mode="Ignore">
                <hud:AvatarHudIconButton name="neutralAffectButton" tooltip="自然" icon-class="icon-neutral" class="radial-button secondary-button secondary-slot-0" />
                <hud:AvatarHudIconButton name="happyAffectButton" tooltip="开心" icon-class="icon-happy" class="radial-button secondary-button secondary-slot-1" />
                <hud:AvatarHudIconButton name="relaxedAffectButton" tooltip="放松" icon-class="icon-relaxed" class="radial-button secondary-button secondary-slot-2" />
                <hud:AvatarHudIconButton name="sadAffectButton" tooltip="难过" icon-class="icon-sad" class="radial-button secondary-button secondary-slot-3" />
                <hud:AvatarHudIconButton name="angryAffectButton" tooltip="生气" icon-class="icon-angry" class="radial-button secondary-button secondary-slot-4" />
                <hud:AvatarHudIconButton name="surprisedAffectButton" tooltip="惊讶" icon-class="icon-surprised" class="radial-button secondary-button secondary-slot-5" />
            </ui:VisualElement>

            <ui:VisualElement name="actionMenu" class="menu-group secondary-menu" picking-mode="Ignore">
                <hud:AvatarHudIconButton name="greetWaveButton" tooltip="挥手" icon-class="icon-hand" class="radial-button secondary-button secondary-slot-0" />
                <hud:AvatarHudIconButton name="explainButton" tooltip="解释" icon-class="icon-explain" class="radial-button secondary-button secondary-slot-1" />
                <hud:AvatarHudIconButton name="celebrateButton" tooltip="庆祝" icon-class="icon-party" class="radial-button secondary-button secondary-slot-2" />
                <hud:AvatarHudIconButton name="coughButton" tooltip="咳嗽" icon-class="icon-wind" class="radial-button secondary-button secondary-slot-3" />
                <hud:AvatarHudIconButton name="cancelActionButton" tooltip="停止当前动作" icon-class="icon-stop" class="radial-button secondary-button secondary-slot-4" />
            </ui:VisualElement>

            <ui:VisualElement name="moreMenu" class="menu-group secondary-menu" picking-mode="Ignore">
                <hud:AvatarHudIconButton name="lightDesktopButton" tooltip="亮色桌面" icon-class="icon-sun" class="radial-button secondary-button secondary-slot-1" />
                <hud:AvatarHudIconButton name="darkDesktopButton" tooltip="暗色桌面" icon-class="icon-moon" class="radial-button secondary-button secondary-slot-2" />
                <hud:AvatarHudIconButton name="softOutlineButton" tooltip="切换柔和描边" icon-class="icon-outline" class="radial-button secondary-button secondary-slot-3" />
                <hud:AvatarHudIconButton name="statusHudButton" tooltip="切换状态卡" icon-class="icon-status-hud" class="radial-button secondary-button secondary-slot-4" />
                <hud:AvatarHudIconButton name="resetBehaviorButton" tooltip="恢复默认行为" icon-class="icon-reset" class="radial-button secondary-button secondary-slot-5" />
            </ui:VisualElement>

            <ui:Button name="centralMenuButton" tooltip="角色控制" class="central-menu-button">
                <hud:AvatarHudStarElement class="central-star-art" picking-mode="Ignore" />
            </ui:Button>
        </hud:AvatarRadialMenu>

        <hud:AvatarHudTooltipElement name="hudTooltip" class="hud-tooltip" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
