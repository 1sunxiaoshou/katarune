QWidget { background: transparent; color: #403b35; font-family: "Microsoft YaHei UI"; font-size: 15px; }
QWizard { border-image: url(:/katarune/background.png) 0 0 0 0 stretch stretch; }
QWizardPage { border: none; }
/* Canvas actions forward to Qt navigation; only those native buttons collapse. */
QPushButton { min-width: 76px; min-height: 38px; padding: 0 16px; background: #faf5eb; color: #403b35; border: 1px solid #b8a17e; border-radius: 10px; }
QPushButton:hover { background: #ece2d2; }
QPushButton:pressed { background: #ddd0bb; }
QPushButton#qt_wizard_back, QPushButton#qt_wizard_next, QPushButton#qt_wizard_commit,
QPushButton#qt_wizard_finish, QPushButton#qt_wizard_cancel,
QPushButton#__qt__passive_wizardbutton0, QPushButton#__qt__passive_wizardbutton1,
QPushButton#__qt__passive_wizardbutton2, QPushButton#__qt__passive_wizardbutton3 {
  min-width: 0; max-width: 0; min-height: 0; max-height: 0; padding: 0; margin: 0; border: none;
}
/* Qt 6.6's anonymous bottom ruler is a QWidget with fixed height 2. */
QWizard QWidget[minimumHeight="2"][maximumHeight="2"] { min-height: 0; max-height: 0; }
QWizard QFrame { border: none; }
QMessageBox, QFileDialog { background: #faf7f1; }
QMessageBox QLabel { background: #faf7f1; color: #403b35; }
QProgressBar { border: 1px solid #baa37f; border-radius: 9px; min-height: 18px; color: #403b35; background: #faf7f1; text-align: center; }
QProgressBar::chunk { background: #b59a6d; border-radius: 8px; }
QPushButton#Primary, QPushButton#Cancel, QPushButton#Browse {
  max-width: 1000px; max-height: 100px; font-size: 16px; border: none;
  qproperty-focusPolicy: StrongFocus;
}
QPushButton#Primary { min-width: 160px; min-height: 46px; color: #faf5eb; font-size: 21px; background: #504a42; border: 1px solid #b8a17e; border-radius: 12px; }
QPushButton#Primary:hover { background: #625749; }
QPushButton#Primary:pressed { background: #403b35; }
QPushButton#Primary:focus { color: #ffe3a0; }
QPushButton#Primary:disabled { background: #81776b; color: #e9e2d8; }
QPushButton#Cancel { min-width: 76px; min-height: 46px; background: #faf5eb; border: 1px solid #b8a17e; border-radius: 12px; }
QPushButton#Cancel:hover { background: #ece2d2; }
QPushButton#Cancel:pressed { background: #ddd0bb; }
QPushButton#Cancel:focus { color: #947247; }
QPushButton#Cancel:disabled { color: #a79c8b; border-color: #d2c5b2; }
QPushButton#Browse { min-width: 60px; min-height: 26px; border: 1px solid #b8a17e; border-radius: 12px; font-size: 12px; }
QPushButton#Browse:hover, QPushButton#Browse:focus { background: #ece2d2; }
QLabel#Name { font-family: "SimSun"; font-size: 40px; color: #292622; }
QLabel#LatinName { font-family: "Segoe Print"; font-size: 25px; color: #292622; }
QLabel#PathLabel { color: #a08968; font-size: 12px; }
QLabel#Status { font-family: "SimSun"; font-size: 24px; }
QLabel#Stage { font-size: 12px; color: #807460; }
QLabel#Feedback { font-size: 13px; color: #916344; }
QLineEdit#Path { font-size: 12px; padding: 3px 0; border: none; border-bottom: 1px solid #b8a17e; selection-background-color: #b8a17e; }
QCheckBox { spacing: 12px; font-family: "Microsoft YaHei UI"; font-size: 15px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid #b8a17e; border-radius: 10px; background: #faf5eb; }
QCheckBox::indicator:checked { background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #fffaf0, stop:0.27 #fffaf0, stop:0.28 #504a42, stop:1 #504a42); }
QCheckBox::indicator:unchecked:hover { background: #ece2d2; border-color: #947247; }
QCheckBox::indicator:checked:hover { background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #fffaf0, stop:0.27 #fffaf0, stop:0.28 #625749, stop:1 #625749); border-color: #947247; }
QCheckBox:focus { color: #947247; }
QProgressBar#ArtProgress { border: 1px solid #baa37f; border-radius: 9px; min-height: 18px; max-height: 18px; color: #403b35; text-align: center; font-size: 11px; background: #faf7f1; }
QProgressBar#ArtProgress::chunk { background: #b59a6d; border-radius: 8px; }
