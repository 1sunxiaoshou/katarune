{
  "name": "katarune",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first digital character harness.",
  "author": "Katarune contributors",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "electron:install": "install-electron --no",
    "predev": "npm run electron:install",
    "dev": "electron-vite dev",
    "prestart": "npm run electron:install",
    "start": "electron-vite preview",
    "db:generate": "drizzle-kit generate",
    "models:snapshot": "node scripts/update-model-catalog-snapshot.mjs",
    "test": "vitest run",
    "test:ai:deepseek": "node tests/run-deepseek-live.mjs",
    "test:ai:openai-tts": "node tests/run-openai-tts-live.mjs",
    "test:ai:google-tts": "node tests/run-google-tts-live.mjs",
    "test:ai:fish-audio-tts": "node tests/run-fish-audio-tts-live.mjs",
    "test:credentials": "node tests/run-credential-integration.mjs",
    "test:database": "node tests/run-database-integration.mjs",
    "test:ui": "npm run build && npm run test:ui:run",
    "test:ui:run": "node tests/run-ui-smoke.mjs",
    "test:startup": "npm run build && node tests/run-startup-integration.mjs",
    "test:watch": "vitest",
    "validate:ai": "vitest run tests/ai-runtime.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "build": "npm run typecheck && electron-vite build",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.14",
    "@ai-sdk/anthropic": "4.0.16",
    "@ai-sdk/deepseek": "3.0.12",
    "@ai-sdk/google": "4.0.18",
    "@ai-sdk/mcp": "2.0.15",
    "@ai-sdk/moonshotai": "3.0.15",
    "@ai-sdk/openai": "4.0.16",
    "@ai-sdk/openai-compatible": "3.0.12",
    "@ai-sdk/xai": "4.0.16",
    "ai": "7.0.31",
    "assistant-stream": "0.3.26",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.34",
    "@assistant-ui/react": "0.14.27",
    "@assistant-ui/react-ai-sdk": "1.3.41",
    "@assistant-ui/react-markdown": "0.14.6",
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource/yellowtail": "5.3.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-kit": "0.31.10",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.25.0",
    "pinyin-pro": "3.28.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "6.2.3",
    "remark-gfm": "4.0.1",
    "shadcn": "4.13.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.12",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "zustand": "5.0.14"
  }
}
